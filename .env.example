# Single-owner private Telegram conversation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_CHAT_ID=
REQUEST_TIMEOUT_SECONDS=20
USER_AGENT=EventRadar/0.1
WEATHER_LOCATION_NAME=Santa Rosa, CA
WEATHER_LATITUDE=38.44047
WEATHER_LONGITUDE=-122.71443
WEATHER_TIMEZONE=America/Los_Angeles
HIKE_CATALOG_PATH=data/hikes.json
USER_CONTEXT_PATH=config/user_context.json
PERSONAL_EXPERIENCE_CONTEXT_PATH=config/personal_experience_preference_context.md
OPENAI_API_KEY=
# AI #1 and AI #3 fall back to OPENAI_MODEL when their overrides are blank.
# AI #2 defaults to gpt-6.1-sol; an explicitly blank override uses OPENAI_MODEL.
OPENAI_MODEL=gpt-5.6
OPENAI_EVENT_ANALYSIS_MODEL=gpt-5.6
OPENAI_WEB_DISCOVERY_MODEL=gpt-6.1-sol
OPENAI_CURATION_MODEL=gpt-5.6
# Token-only prices per 1M tokens, selected by each stage's actual model ID.
# Optional JSON replacement for the full pricing map (unknown models report cost n/a).
# Replaces the former global OPENAI_*_USD_PER_MILLION settings.
# OPENAI_MODEL_PRICING={"gpt-5.6":{"input_usd_per_million":4,"cached_input_usd_per_million":0.4,"output_usd_per_million":20},"gpt-6.1-sol":{"input_usd_per_million":2,"cached_input_usd_per_million":0.1,"output_usd_per_million":10}}
OPENAI_TIMEOUT_SECONDS=120
EVENT_ANALYSIS_PROMPT_PATH=prompts/event_analysis.md
WEB_DISCOVERY_PROMPT_PATH=prompts/web_event_discovery.md
CURATION_PROMPT_PATH=prompts/weekend_curation.md
CURATION_OUTPUT_DIR=output

# E0 backend-only development configuration (never expose in VITE_* variables).
# Needed only by explicit database operations; API/CLI startup does not require it.
# Export in your shell; Alembic does not automatically load this file.
DATABASE_URL=

# Backend-only opt-in PostgreSQL integration tests; never falls back to DATABASE_URL.
TEST_DATABASE_URL=

# Backend CORS allowlist: comma-separated origins, no wildcards or paths.
WEB_ORIGINS=http://localhost:5173

# Backend Supabase user-token verification; no secret/service-role/shared JWT key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
